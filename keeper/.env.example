# Required
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
KEEPER_PRIVATE_KEY=          # burner key only; needs gas, plus mETH and mUSD for arbitrage and liquidations
MODE=offline                 # offline (anvil, no Pyth) | live (public testnet, pushes Pyth updates)
DEPLOYMENTS_PATH=../contracts/deployments/active.json

# Jobs (true/false)
ENABLE_GLIDER=true
ENABLE_ORACLE_PUSHER=true    # only acts in live mode on a Pyth deployment
ENABLE_GHOST_LIQUIDATOR=true
ENABLE_ARBITRAGEUR=true

# Tuning (defaults shown; arbitrage matches the Cascade Lab: α = 30%, budget 2% of the mUSD reserve)
BATCH_SIZE=20
ARB_EVERY_BLOCKS=3
ARB_ALPHA_BPS=3000
ARB_BUDGET_BPS=200
ARB_THRESHOLD_BPS=30
ORACLE_PUSH_EVERY_S=30
HERMES_URL=https://pyth.dourolabs.app/hermes
PYTH_API_KEY=                # required for the oracle pusher since the Aug 2026 Pyth Core upgrade (Pyth Terminal)
POLL_MS=1000
HEALTH_PORT=8081
LOW_GAS_ETH=0.01
SUMMARY_EVERY_S=60

# Seed script only (npm run seed): owner of the mock tokens and oracle
SEED_PRIVATE_KEY=
SEED_COUNT=40
