# Chain the contracts are deployed on. For chain 31337 (anvil) RPC_URL defaults to http://127.0.0.1:8545.
RPC_URL=
# Deployment record written when you deploy (addresses + startBlock). Default:
DEPLOYMENTS_PATH=../contracts/deployments/active.json
# Wallets opened by keeper/scripts/seed-activity.ts, labelled on the site. Default:
SEEDED_PATH=../contracts/deployments/seeded.json
# Record oracle + AMM price every N blocks
PRICE_TICK_EVERY=5
# Leave empty for the embedded PGlite database (works offline); set to use Postgres
DATABASE_URL=
