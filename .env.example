# Root .env (never committed). Used by `node scripts/ops.mjs deploy-testnet`.
# Each package also has its own .env.example (web/, indexer/, keeper/).

# chain
CHAIN_ID=84532                 # Base Sepolia; 421614 for Arbitrum Sepolia
RPC_URL=
EXPLORER_API_KEY=              # source verification (Etherscan-family)
VERIFIER_URL=                  # set only for Blockscout explorers: their /api URL
DEPLOYER_PRIVATE_KEY=          # burner only
KEEPER_PRIVATE_KEY=            # burner only, different from the deployer
KEEPER_ADDRESS=                # gets mETH + mUSD inventory at deploy time

# pyth (live) — take both from Pyth's official docs for your chain, not from memory
PYTH_ADDRESS=
PYTH_ETH_USD_FEED_ID=
START_PRICE=                   # optional: AMM seed price if the Pyth feed is stale at deploy time
PYTH_MAX_AGE=600               # oldest Pyth price accepted (s). 600 = rely on Pyth's own pushes, no API key needed;
                               # 60 = needs the keeper pushing Hermes updates, which requires a paid PYTH_API_KEY

# web (set these in Vercel for the live site)
NEXT_PUBLIC_MODE=live          # live | offline
NEXT_PUBLIC_CHAIN_ID=84532
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_INDEXER_URL=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
